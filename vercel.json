{
  "version": 2,
  "builds": [
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "index.php",
      "use": "vercel-php@0.7.3"
    },
    {
      "src": "api/index.php",
      "use": "vercel-php@0.7.3",
      "config": {
        "includeFiles": [
          "assets/**",
          "config/**",
          "includes/**",
          "auth/**",
          "habits/**",
          "history/**",
          "profile/**",
          "reports/**",
          "*.php"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
